# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clipper"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Storage (S3-compatible: AWS, R2, MinIO) ---
STORAGE_PROVIDER="s3"          # s3 | local
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="clipper-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"     # required for MinIO
# Used when STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR="./.storage"

# --- Transcription ---
TRANSCRIPTION_PROVIDER="whisper-local"   # whisper-local | openai | deepgram
# whisper-local
WHISPER_BINARY="whisper"
WHISPER_MODEL="large-v3"
# openai
OPENAI_API_KEY=""
# deepgram
DEEPGRAM_API_KEY=""

# --- Clip analysis ---
ANALYSIS_PROVIDER="anthropic"  # anthropic | openai | heuristic
ANTHROPIC_API_KEY=""
ANALYSIS_MODEL="claude-sonnet-4-6"

# --- Processing ---
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
TEMP_DIR="/tmp/clipper"
MAX_UPLOAD_BYTES="5368709120"  # 5GB
WORKER_CONCURRENCY="2"
