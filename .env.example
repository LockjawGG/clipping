# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clipper"
# Direct (non-pooled) URL used only for migrations. Set it to the same value as
# DATABASE_URL, unless your provider gives a separate pooled URL (Neon, Supabase),
# in which case put the unpooled one here.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/clipper"
# Signs NextAuth sessions AND the local storage upload/download URLs. Required.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Storage (S3-compatible: AWS, R2, MinIO) ---
STORAGE_PROVIDER="s3"          # s3 | local
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="clipper-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"     # required for MinIO
# Used when STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR="./.storage"

# --- Transcription ---
TRANSCRIPTION_PROVIDER="whisper-local"   # whisper-local | openai | deepgram
# whisper-local
WHISPER_BINARY="whisper"
WHISPER_MODEL="large-v3"
# openai
OPENAI_API_KEY=""
# deepgram
DEEPGRAM_API_KEY=""

# --- Clip analysis ---
ANALYSIS_PROVIDER="heuristic"  # anthropic | openai | heuristic (heuristic needs no key)
ANTHROPIC_API_KEY=""
# openai analysis reuses OPENAI_API_KEY from the transcription section above.
# Model for the active provider: a Claude id for anthropic, a GPT id for openai.
ANALYSIS_MODEL="claude-opus-5"

# --- Processing ---
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
YTDLP_PATH="yt-dlp"            # for the "add from link" flow (YouTube, Rumble, Vimeo, …)
# Browser yt-dlp impersonates so Cloudflare-fronted hosts (Rumble) don't 403.
# Needs a yt-dlp build with curl_cffi (the standalone binary bundles it). "" = off.
YTDLP_IMPERSONATE="chrome"
TEMP_DIR="/tmp/clipper"
MAX_UPLOAD_BYTES="5368709120"  # 5GB
WORKER_CONCURRENCY="2"

# --- Text to speech (voiceover) and translation ---
# Piper runs locally. Point these at real paths rather than leaving them to
# PATH or the relative default: the desktop app is launched from Explorer,
# where the working directory is not the project and "./.voices" is nothing.
PIPER_BINARY="piper"
PIPER_VOICE_DIR="./.voices"   # absolute path recommended; needs at least one .onnx voice
PIPER_VOICE=""                # default voice id, e.g. en_US-lessac-medium
PYTHON_BIN="python"           # used for local translation (argostranslate)
