// Data model for the clipping app.
//
// Design notes that matter:
// - Timestamps are stored as integer milliseconds, never floats. Float seconds
//   accumulate rounding error once you slice, re-cut, and re-render, and cue
//   boundaries start drifting off the audio.
// - Words are a separate table from segments. Karaoke/highlight captions need
//   word-level timing; sentence-level rows alone can't drive them.
// - Every long-running operation is a Job row. The API never blocks on ffmpeg.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. Point it at the same value
  // as DATABASE_URL unless your provider hands out a separate pooled URL
  // (Neon, Supabase, …), in which case use the unpooled one here.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  imageUrl     String?
  // bcrypt hash for the credentials provider. Null for users created another way.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
  assets   Asset[]

  @@map("users")
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos     Video[]
  savedClips Clip[]  @relation("SavedClips")

  // Every list query is scoped by owner. Index accordingly.
  @@index([userId, updatedAt])
  @@map("projects")
}

enum AssetKind {
  IMAGE
  GIF
  AUDIO
  SFX
}

/// Reusable media in a user's library: image / GIF overlays and audio / SFX
/// beds. Owned by the user, shared across all their projects. Referenced by
/// `Overlay` (visual) and sequence audio tracks.
model Asset {
  id         String    @id @default(cuid())
  userId     String
  kind       AssetKind
  name       String
  storageKey String    @unique
  mimeType   String
  sizeBytes  BigInt?
  // Intrinsic dimensions for images/GIFs; duration for audio/GIF.
  width      Int?
  height     Int?
  durationMs Int?
  favoritedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  overlays      Overlay[]
  sequenceItems SequenceItem[]

  @@index([userId, createdAt])
  @@map("assets")
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  PROBING
  TRANSCRIBING
  READY
  FAILED
  // A live capture in progress (mic / screen audio recorded in the browser,
  // chunk-uploaded and transcribed as it comes in). Finalised into a normal
  // clippable video when the user hits Stop.
  LIVE
}

/// One ~8s audio slice of a live recording, uploaded from the browser while the
/// session runs. Each gets a LIVE_TRANSCRIBE job; on Stop they're concatenated
/// into the video's source and the whole thing is re-transcribed for quality.
model LiveChunk {
  id         String   @id @default(cuid())
  videoId    String
  index      Int
  storageKey String   @unique
  /// Offset of this chunk from the start of the session, in ms.
  startMs    Int
  durationMs Int?
  /// Size the browser said it uploaded. Finalisation compares this against the
  /// stored object so a truncated fragment is distinguishable from a missing
  /// one — joined blind, a short fragment corrupts the stream silently.
  bytes      Int?
  /// PENDING → DONE / FAILED (rolling transcription of this chunk).
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, index])
  @@index([videoId, index])
  @@map("live_chunks")
}

model Video {
  id        String      @id @default(cuid())
  projectId String
  status    VideoStatus @default(UPLOADING)

  // Client-supplied name is display-only. storageKey is server-generated and is
  // the only value ever passed to ffmpeg or the storage SDK.
  originalFilename String
  storageKey       String  @unique
  thumbnailKey     String?

  // For URL ingests: the normalised source URL and its hash. A repeat submission
  // of the same URL reuses the already-transcribed video instead of re-fetching.
  sourceUrl     String?
  sourceUrlHash String?

  sizeBytes    BigInt?
  durationMs   Int?
  width        Int?
  height       Int?
  fps          Float?
  videoCodec   String?
  audioCodec   String?
  audioChannels Int?
  sampleRate   Int?
  hasAudio     Boolean @default(true)

  errorMessage String?

  /// Last check-in from the browser recording into this video. Only meaningful
  /// while status is LIVE: a lapsed heartbeat means the tab died, and the
  /// sweeper finalises the session from whatever fragments already landed.
  liveHeartbeatAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcript    Transcript?
  clips         Clip[]
  jobs          Job[]
  sequenceItems SequenceItem[]
  liveChunks    LiveChunk[]

  @@index([projectId, createdAt])
  @@index([sourceUrlHash])
  @@index([status, liveHeartbeatAt])
  @@map("videos")
}

model Transcript {
  id        String   @id @default(cuid())
  videoId   String   @unique
  provider  String
  model     String?
  language  String
  // Mean segment confidence, used as a render-time quality gate.
  confidence Float?
  createdAt DateTime @default(now())

  video    Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id           String @id @default(cuid())
  transcriptId String
  index        Int
  startMs      Int
  endMs        Int
  text         String
  speaker      String?
  confidence   Float?

  transcript Transcript       @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  words      TranscriptWord[]

  // Range scans over a window of the timeline are the hot path for the editor.
  @@unique([transcriptId, index])
  @@index([transcriptId, startMs])
  @@map("transcript_segments")
}

model TranscriptWord {
  id         String @id @default(cuid())
  segmentId  String
  index      Int
  startMs    Int
  endMs      Int
  text       String
  confidence Float?

  segment    TranscriptSegment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  wordStyles CaptionWordStyle[]

  @@unique([segmentId, index])
  @@index([segmentId, startMs])
  @@map("transcript_words")
}

/// Per-word caption styling for one clip: colour / bold / italic / size that
/// overrides the clip's base SubtitleConfig for a single transcript word.
/// Keyed by word id so it survives text corrections; cascades away if the
/// transcript is regenerated (the word ids change).
model CaptionWordStyle {
  id        String   @id @default(cuid())
  clipId    String
  wordId    String
  color     String?
  bold      Boolean?
  italic    Boolean?
  /// Multiplier on the base font size, e.g. 1.4. Applied in preview + Remotion.
  sizeScale Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clip Clip           @relation(fields: [clipId], references: [id], onDelete: Cascade)
  word TranscriptWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([clipId, wordId])
  @@index([clipId])
  @@map("caption_word_styles")
}

enum ClipOrigin {
  AI_SUGGESTED
  USER_CREATED
}

enum AspectRatio {
  VERTICAL_9_16
  SQUARE_1_1
  LANDSCAPE_16_9
  PORTRAIT_4_5
}

model Clip {
  id      String     @id @default(cuid())
  videoId String
  origin  ClipOrigin @default(AI_SUGGESTED)

  startMs Int
  endMs   Int

  title       String
  hook        String?
  description String?
  // Why the model picked this window. Shown in the UI so the suggestion is
  // auditable rather than a black box.
  reason         String?
  caption        String?
  socialTitle    String?
  hashtags       String[] @default([])
  score          Float?

  aspectRatio AspectRatio @default(VERTICAL_9_16)
  // Normalised 0..1 crop centre. Null means "auto / face-tracked".
  focalX      Float?
  focalY      Float?
  muted       Boolean @default(false)
  volume      Float   @default(1.0)
  playbackRate Float  @default(1.0)

  // Word ids the user struck out in the transcript editor; the renderer cuts
  // these spans and concatenates the remainder.
  removedWordIds String[] @default([])

  accepted  Boolean  @default(false)
  // Project the user filed this clip under. Independent of the source video's
  // project; drives the per-project "Saved clips" rail. Null = not saved.
  savedToProjectId String?
  // Poster frame grabbed at the clip midpoint by the THUMBNAIL job.
  thumbnailKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video          Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  savedToProject Project?        @relation("SavedClips", fields: [savedToProjectId], references: [id], onDelete: SetNull)
  subtitleConfig SubtitleConfig?
  overlays       Overlay[]
  renders        Render[]
  wordStyles     CaptionWordStyle[]
  sequence       Sequence?

  @@index([videoId, startMs])
  @@index([savedToProjectId])
  @@map("clips")
}

/// An optional non-linear timeline for a clip. When present, the render
/// composes the sequence items instead of the clip's plain [startMs,endMs] cut.
/// Absent on a clip = today's behaviour, unchanged.
model Sequence {
  id        String   @id @default(cuid())
  clipId    String   @unique
  /// Output frame size / rate for this sequence's render (independent of the
  /// clip's own aspectRatio).
  width     Int      @default(1080)
  height    Int      @default(1920)
  fps       Int      @default(30)
  /// UI toggle for edge/playhead snapping; does not affect the render.
  snap      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clip   Clip            @relation(fields: [clipId], references: [id], onDelete: Cascade)
  tracks SequenceTrack[]
  items  SequenceItem[]

  @@map("sequences")
}

enum SequenceTrackKind {
  VIDEO
  AUDIO
  OVERLAY
}

model SequenceTrack {
  id         String            @id @default(cuid())
  sequenceId String
  /// Display / stacking order; 0 = top.
  index      Int
  kind       SequenceTrackKind @default(VIDEO)
  name       String
  muted      Boolean           @default(false)
  locked     Boolean           @default(false)

  sequence Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  items    SequenceItem[]

  @@unique([sequenceId, index])
  @@index([sequenceId])
  @@map("sequence_tracks")
}

/// One placed piece of media on a sequence track. Non-destructive: it references
/// a slice [sourceIn,sourceOut] of a source and never alters the source bytes.
model SequenceItem {
  id         String @id @default(cuid())
  sequenceId String
  trackId    String

  /// Exactly one of these. A video item plays a range of a project Video; an
  /// asset item places an image / GIF / audio bed from the media library.
  sourceVideoId String?
  sourceAssetId String?

  /// Position on the sequence timeline (ms) and the slice of the source shown.
  timelineStart Int
  sourceIn      Int @default(0)
  sourceOut     Int
  /// Left-to-right tiebreak within a track for equal starts.
  order         Int @default(0)

  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequence Sequence      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  track    SequenceTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  video    Video?        @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  asset    Asset?        @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@index([trackId, timelineStart])
  @@map("sequence_items")
}

enum SubtitlePreset {
  CLASSIC
  BOLD
  VIRAL
  MINIMAL
  KARAOKE
}

enum CaptionAnimation {
  NONE
  WORD_BY_WORD
  POP
  SCALE
  BOUNCE
  FADE
  KARAOKE
  SLIDE_UP
  TYPEWRITER
}

model SubtitleConfig {
  id     String         @id @default(cuid())
  clipId String         @unique
  preset SubtitlePreset @default(CLASSIC)

  fontFamily     String  @default("Inter")
  fontSizePx     Int     @default(64)
  fontWeight     Int     @default(700)
  textColor      String  @default("#FFFFFF")
  highlightColor String  @default("#FFE600")
  outlineColor   String  @default("#000000")
  outlineWidthPx Int     @default(6)
  shadowOpacity  Float   @default(0.5)
  backgroundColor String?
  // 0..1 from the top of the frame.
  positionY      Float   @default(0.78)
  alignment      String  @default("center")
  animation      CaptionAnimation @default(NONE)

  maxCharsPerLine Int @default(38)
  maxLines        Int @default(2)
  maxWordsPerCue  Int @default(7)
  minCueMs        Int @default(800)
  maxCueMs        Int @default(5000)

  uppercase Boolean @default(false)

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@map("subtitle_configs")
}

enum OverlayKind {
  TEXT
  EMOJI
  IMAGE
}

model Overlay {
  id      String      @id @default(cuid())
  clipId  String
  kind    OverlayKind
  /// For TEXT: the string. For IMAGE/EMOJI backed by a library asset: unused.
  content String
  /// Set for IMAGE/GIF overlays that point at a library asset.
  assetId String?
  // Normalised 0..1 layout so overlays survive an aspect-ratio change.
  x       Float
  y       Float
  scale   Float @default(1.0)
  rotation Float @default(0)
  opacity Float @default(1.0)
  startMs Int?
  endMs   Int?
  // Stacking order within the clip; higher sits on top. The editor's "layer
  // strip" is this list, sorted by zIndex.
  zIndex  Int   @default(0)
  // Hidden layers stay in the project but are skipped in the preview and the
  // render (the eye toggle in the layer strip).
  hidden  Boolean @default(false)

  clip  Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([clipId])
  @@map("overlays")
}

enum RenderQuality {
  P720
  P1080
  ORIGINAL
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Render {
  id      String        @id @default(cuid())
  clipId  String
  quality RenderQuality @default(P1080)
  status  JobStatus     @default(QUEUED)

  outputKey    String?
  sizeBytes    BigInt?
  durationMs   Int?
  progress     Float     @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId, createdAt])
  @@map("renders")
}

enum JobKind {
  FETCH
  PROBE
  EXTRACT_AUDIO
  TRANSCRIBE
  ANALYZE
  RENDER
  THUMBNAIL
  // Rolling transcription of one live-capture chunk.
  LIVE_TRANSCRIBE
  // Stop pressed: concat the chunks into a source file, then rejoin the normal
  // chain (probe → full re-transcribe → analyze → thumbnail).
  LIVE_FINALIZE
}

model Job {
  id      String    @id @default(cuid())
  videoId String
  kind    JobKind
  status  JobStatus @default(QUEUED)

  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  progress    Float    @default(0)
  payload     Json?
  result      Json?
  errorMessage String?
  // Set on retry with exponential backoff; workers skip rows not yet due.
  runAfter    DateTime @default(now())
  // Stamped when a worker claims the job; the baseline for progress ETAs.
  startedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([videoId, kind])
  @@map("jobs")
}
